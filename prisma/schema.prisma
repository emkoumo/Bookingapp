generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id             String          @id @default(uuid())
  name           String
  email          String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailTemplates EmailTemplate[]
  paymentMethods PaymentMethod[]
  properties     Property[]
  pricingSettings PricingSettings?
}

/**
 * Per-business pricing constants. One row per business, created on demand with
 * the defaults below, so a business without a row behaves exactly as if it had
 * the default one.
 *
 * The climate fee lives here because it is a state rule rather than a pricing
 * decision: the amounts and the month boundary can change by law.
 */
model PricingSettings {
  id                   String   @id @default(uuid())
  businessId           String   @unique
  // Booking.com commission, as a percentage.
  commissionPercent    Decimal  @default(15) @db.Decimal(5, 2)
  // Climate resilience fee per night: high season vs low.
  climateFeeHigh       Decimal  @default(8) @db.Decimal(10, 2)
  climateFeeLow        Decimal  @default(2) @db.Decimal(10, 2)
  // Inclusive month numbers for the high-fee season (April–October).
  highSeasonStartMonth Int      @default(4)
  highSeasonEndMonth   Int      @default(10)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Property {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  icalUrl      String?
  bookings     Booking[]
  priceRanges  PriceRange[]
  blockedDates BlockedDate[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Booking {
  id                     String   @id @default(uuid())
  propertyId             String
  customerName           String
  contactInfo            String?
  contactChannel         String?
  checkIn                DateTime @db.Date
  checkOut               DateTime @db.Date
  deposit                String?
  notes                  String?
  status                 String   @default("active")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  externalId             String?
  // "manual" for a direct booking, "booking_com" for one that came through
  // Booking.com. The column already existed and was unused, so the channel
  // needs no new field.
  source                 String   @default("manual")
  totalPrice             Decimal? @db.Decimal(10, 2)
  advancePayment         Decimal? @db.Decimal(10, 2)
  remainingBalance       Decimal? @db.Decimal(10, 2)
  advancePaymentMethod   String?
  advancePaymentDate     DateTime? @db.Date
  extraBedEnabled        Boolean  @default(false)
  extraBedPricePerNight  Decimal? @db.Decimal(10, 2)
  extraBedTotal          Decimal? @db.Decimal(10, 2)
  // Set when the price was entered by hand rather than derived from the price
  // list. Now purely a display flag (the orange marker): since the price-list
  // recalculation was removed, no code path can rewrite a reservation's price.
  hasCustomPrice         Boolean  @default(false)
  // Party size. Nullable on purpose: the bookings that predate these columns
  // recorded their counts as free text in `notes`, and storing 0 would assert
  // "no guests" where the truth is "not recorded yet". `notes` stays the home
  // for the details these two cannot hold — ages, cots, pets.
  adults                 Int?
  children               Int?

  // ---- Price snapshot and income -------------------------------------------
  // All nullable, and that IS the safety mechanism: a reservation predating
  // these columns has them NULL, so every display falls back to totalPrice and
  // nothing about it is reinterpreted.
  //
  // Per-night snapshot: [{"date":"2027-07-12","price":392,"manual":false}].
  // `price` is the CHANNEL price — the quoted price for Direct, the Extranet
  // price before commission and fee for Booking. Frozen at creation, so a
  // later price-list or commission change cannot move it; on a date edit the
  // surviving nights keep these values and only new nights are priced.
  nightlyPrices          Json?
  // What is actually kept: channel price less commission for Booking, the
  // price itself for every other channel. totalPrice is kept equal to this.
  income                 Decimal? @db.Decimal(10, 2)
  // Hand-corrected payout, for when the real Booking transfer is known. Wins
  // over the calculation and carries the orange manual flag.
  incomeOverride         Decimal? @db.Decimal(10, 2)
  // Informational only — what the guest paid, including the climate fee on
  // Booking. Never part of income, reports or any total.
  guestPaid              Decimal? @db.Decimal(10, 2)
  // Commission rate in force when this reservation was made, so changing the
  // setting later cannot move the income of past reservations.
  commissionPercent      Decimal? @db.Decimal(5, 2)
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([checkIn])
  @@index([checkOut])
  @@index([status])
  @@index([externalId])
}

model EmailTemplate {
  id                    String   @id @default(uuid())
  businessId            String
  name                  String
  subject               String
  body                  String
  imageUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  includeImageByDefault Boolean  @default(false)
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, name])
}

model PaymentMethod {
  id         String   @id @default(uuid())
  businessId String
  type       String
  label      String
  details    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model PriceRange {
  id            String   @id @default(uuid())
  propertyId    String
  dateFrom      DateTime @db.Date
  // dateTo is the LAST NIGHT of the range, not a check-out day:
  // 13–15 Aug is three nights (13th, 14th, 15th).
  dateTo        DateTime @db.Date
  // "Απευθείας κράτηση" — the rounded price quoted by phone or message, used
  // for every channel except Booking. Required.
  //
  // Kept under its original name rather than renamed to directPrice: the 74
  // existing rows already hold exactly this value, so leaving the column alone
  // means the Direct price needs no migration at all.
  pricePerNight Decimal  @db.Decimal(10, 2)
  // "Κράτηση Booking" — the nightly price set in Booking's Extranet, before the
  // climate fee. Optional: when a stay's nights have no Booking price, the
  // Booking channel cannot be priced and says so rather than falling back.
  bookingPrice  Decimal? @db.Decimal(10, 2)
  // Optional period label ("Κορύφωση", "Πάσχα 2027"), used in the price
  // overview and the quote breakdown. Existing ranges stay unnamed.
  name          String?
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId])
  @@index([propertyId, dateFrom, dateTo])
}

model BlockedDate {
  id         String   @id @default(uuid())
  propertyId String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, startDate, endDate])
  @@index([startDate])
  @@index([endDate])
}
